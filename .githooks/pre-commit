#!/usr/bin/env bash
set -euo pipefail

NIX_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.nix$' || true)

if [[ -z "$NIX_FILES" ]]; then
    exit 0
fi

run() {
    if command -v nix >/dev/null 2>&1; then
        nix "$@"
    elif command -v wsl >/dev/null 2>&1; then
        wsl -e bash -l -c "nix $*"
    else
        echo "Warning: nix not found, skipping checks"
        exit 0
    fi
}

echo "Checking formatting..."
run develop --command nix fmt --check $NIX_FILES

echo "Running nixos-rebuild dry-build for nix-laptop..."
run develop --command nixos-rebuild dry-build --flake .#nix-laptop

echo "Running nixos-rebuild dry-build for nix-server..."
run develop --command nixos-rebuild dry-build --flake .#nix-server

echo "All checks passed."
